# TaskBoard reverse proxy. Rendered by envsubst at container start.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Respect X-Forwarded-Proto only when set by a trusted TLS terminator in front of us.
map $http_x_forwarded_proto $fb_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

limit_req_zone $binary_remote_addr zone=fb_auth:10m rate=${NGINX_AUTH_RATE};
limit_req_zone $binary_remote_addr zone=fb_api:20m rate=${NGINX_API_RATE};

upstream fb_api {
    server ${API_UPSTREAM};
    keepalive 64;
}

${NGINX_REALIP_DIRECTIVES}
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY};
    client_body_timeout 60s;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # WebSocket endpoint
    location = /api/v1/ws {
        proxy_pass http://fb_api;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /api/v1/auth/ {
        limit_req zone=fb_auth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://fb_api;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location /api/ {
        limit_req zone=fb_api burst=200 nodelay;
        limit_req_status 429;
        proxy_pass http://fb_api;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 60s;
    }

    # Content-hashed build assets: cache forever
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        ${NGINX_HSTS_DIRECTIVE}
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: every unknown path serves index.html so client-side routes survive refresh
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        ${NGINX_HSTS_DIRECTIVE}
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
