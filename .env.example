# =============================================================================
# ForgeBoard configuration. Copy to `.env`, then run ./scripts/generate-secrets.sh
# to replace the placeholder secrets with strong random values.
# The API refuses to start in production while placeholder secrets remain.
# =============================================================================

# --- General -----------------------------------------------------------------
APP_NAME=ForgeBoard
# production | development | test  (production enforces strong secrets, hides API docs)
APP_ENV=production
# Host port the web UI/API is published on, and the bind address for it.
APP_PORT=8080
APP_BIND_ADDRESS=0.0.0.0
# Externally visible base URL (used in emailed links and as the allowed browser Origin).
PUBLIC_BASE_URL=http://localhost:8080
# Optional comma-separated extra origins allowed for WebSockets / cookie endpoints.
# Leave empty to allow only PUBLIC_BASE_URL.
ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=forgeboard
POSTGRES_USER=forgeboard
POSTGRES_PASSWORD=change-me
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
# Connection pool per API worker process (WEB_CONCURRENCY workers).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- API server ------------------------------------------------------------------
# Number of uvicorn worker processes.
WEB_CONCURRENCY=2

# --- Authentication -----------------------------------------------------------------
# HMAC key for access tokens: >= 32 random characters. Rotating it logs everyone out
# of their current access token (refresh tokens remain valid).
JWT_SECRET=replace-with-secure-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=60
INVITATION_EXPIRE_DAYS=7
# Set to true when users reach ForgeBoard over HTTPS (e.g. behind a TLS-terminating proxy).
COOKIE_SECURE=false

# --- Brute-force protection -----------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
IP_AUTH_RATE_PER_MINUTE=30
REGISTER_RATE_PER_MINUTE=10
PASSWORD_RESET_RATE_PER_MINUTE=5
# nginx request-rate limits per client IP (nginx limit_req syntax).
NGINX_API_RATE=50r/s
NGINX_AUTH_RATE=10r/s
# Comma-separated CIDRs of reverse proxies in front of ForgeBoard whose
# X-Forwarded-For header should be trusted (e.g. 10.0.0.0/8). Default trusts none.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# --- Attachments -----------------------------------------------------------------------
MAX_UPLOAD_MB=10

# --- Email ---------------------------------------------------------------------------------
# console: emails (password reset / invitations) are written to the API log.
# smtp:    delivered through the SMTP server below.
EMAIL_BACKEND=console
EMAIL_FROM=ForgeBoard <no-reply@forgeboard.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_TLS=false
